{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moroccan Darija Context Examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "examples"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexicon_version", "version", "examples_count"],
      "properties": {
        "lexicon_version": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "examples_count": {"type": "integer", "minimum": 0}
      }
    },
    "examples": {
      "type": "array",
      "items": {"$ref": "#/$defs/example"}
    }
  },
  "$defs": {
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry_id", "meaning_ar", "example_darija_ar", "example_darija_latin", "provenance", "review"],
      "properties": {
        "id": {"type": "string", "pattern": "^ctx-[0-9]{6}$"},
        "entry_id": {"type": "integer", "minimum": 1},
        "sense_id": {"type": "string", "minLength": 1},
        "meaning_ar": {"type": "string", "minLength": 1},
        "meaning_fr": {"type": "string"},
        "example_darija_ar": {"type": "string", "minLength": 1},
        "example_darija_latin": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "example_fusha_ar": {"type": "string"},
        "example_fr": {"type": "string"},
        "region": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "register": {"enum": ["neutral", "formal", "informal", "vulgar", "literary", "religious", "unknown"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "redistribution_permission", "training_permission", "commercial_permission"],
      "properties": {
        "source_type": {"enum": ["original", "contributor", "dictionary", "corpus", "web", "other", "unknown"]},
        "source_name": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "accessed_at": {"type": "string", "format": "date"},
        "rights_holder": {"type": "string"},
        "license": {"type": "string"},
        "notes": {"type": "string"},
        "redistribution_permission": {"enum": ["allowed", "not_allowed", "unknown", "not_applicable"]},
        "training_permission": {"enum": ["allowed", "not_allowed", "unknown", "not_applicable"]},
        "commercial_permission": {"enum": ["allowed", "not_allowed", "unknown", "not_applicable"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "in_review", "reviewed", "rejected", "needs_correction", "unknown"]},
        "reviewer_id": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    }
  }
}
